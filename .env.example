# Copy to .env before anything else: Compose reads .env in EVERY subcommand
# (up, stop, down), so without it `docker compose stop` exits 0 and stops nothing.

# Which profile docker compose activates.
#   standalone   this repo starts its own Postgres on :5436 (see docker-compose.yml)
#   poli-runner  injected by poli-runner; the bundled db stays down and POSTGRES_URL
#                comes from the runner (see poli-runner.yml)
COMPOSE_PROFILES=standalone

# Read by backend/app/core/config.py. Declared as a passthrough in docker-compose.yml,
# so it must be set here — a passthrough overrides env_file values and blanks the
# variable when nothing supplies one.
POSTGRES_URL=postgresql://postgres:postgres@db:5432/apras
